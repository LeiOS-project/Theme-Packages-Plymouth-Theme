#
# The wallpaper, logo and blurred bottom panel live in the theme's ImageDir.
# Logs are rendered with Geist Mono (falls back to the default monospace font
# when Geist is not available).

# ---------- Configuration ----------
LOG_FONT = "Geist Mono";
LOGO_HEIGHT_P = 0.18;         # Logo height as fraction of screen height
LOG_PANEL_HEIGHT_P = 0.30;    # Bottom panel height as fraction of screen height
LOG_PANEL_PADDING_P = 0.02;   # Internal panel padding as fraction of screen height
MAX_LOG_LINES = 6;
LOG_COLOR.red = 1.0;
LOG_COLOR.green = 1.0;
LOG_COLOR.blue = 1.0;
LOG_ALPHA = 0.92;

# ---------- Helpers ----------
fun scale_image_to_cover(image) {
    local.screen_w = Window.GetWidth();
    local.screen_h = Window.GetHeight();
    local.screen_ratio = local.screen_w / local.screen_h;
    local.img_ratio = image.GetWidth() / image.GetHeight();
    local.scale;
    if (local.screen_ratio > local.img_ratio)
        local.scale = local.screen_w / image.GetWidth();
    else
        local.scale = local.screen_h / image.GetHeight();
    return image.Scale(image.GetWidth() * local.scale, image.GetHeight() * local.scale);
}

# ---------- Background ----------
bg_image = Image("background.png");
scaled_bg = scale_image_to_cover(bg_image);
bg_sprite = Sprite(scaled_bg);
bg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - scaled_bg.GetWidth() / 2,
                      Window.GetY() + Window.GetHeight() / 2 - scaled_bg.GetHeight() / 2,
                      -10000);

# ---------- Logo ----------
logo_image = Image("logo.png");
logo_h = Window.GetHeight() * LOGO_HEIGHT_P;
logo_scale = logo_h / logo_image.GetHeight();
logo_image = logo_image.Scale(logo_image.GetWidth() * logo_scale, logo_h);
logo_sprite = Sprite(logo_image);
logo_x = Window.GetX() + Window.GetWidth() / 2;
logo_y = Window.GetY() + Window.GetHeight() * 0.40;
logo_sprite.SetPosition(logo_x - logo_image.GetWidth() / 2,
                        logo_y - logo_image.GetHeight() / 2,
                        1000);

# ---------- Log panel ----------
panel_image = Image("log-panel.png");
panel_w = Window.GetWidth();
panel_h = Window.GetHeight() * LOG_PANEL_HEIGHT_P;
panel_image = panel_image.Scale(panel_w, panel_h);
panel_sprite = Sprite(panel_image);
panel_x = Window.GetX();
panel_y = Window.GetY() + Window.GetHeight() - panel_h;
panel_sprite.SetPosition(panel_x, panel_y, 100);

# ---------- Log messages ----------
log_texts[0] = "";
log_texts[1] = "";
log_texts[2] = "";
log_texts[3] = "";
log_texts[4] = "";
log_texts[5] = "";
log_count = 0;

fun message_callback(text) {
    if (!text) text = "";

    if (log_count == MAX_LOG_LINES) {
        for (i = 0; i < MAX_LOG_LINES - 1; i++) {
            log_texts[i] = log_texts[i + 1];
        }
        log_texts[MAX_LOG_LINES - 1] = text;
    } else {
        log_texts[log_count] = text;
        log_count++;
    }

    redraw_logs();
}

fun redraw_logs() {
    local.panel_h = Window.GetHeight() * LOG_PANEL_HEIGHT_P;
    local.panel_top = Window.GetY() + Window.GetHeight() - local.panel_h;
    local.padding = Window.GetHeight() * LOG_PANEL_PADDING_P;
    local.available_h = local.panel_h - local.padding * 2;
    local.line_h = local.available_h / MAX_LOG_LINES;
    local.font_size = Math.Int(local.line_h * 0.65);
    if (font_size < 10) font_size = 10;
    local.font_desc = LOG_FONT + " " + font_size + "px";
    local.x = Window.GetX() + local.padding * 2;

    for (i = 0; i < log_count; i++) {
        local.img = Image.Text(log_texts[i],
                               LOG_COLOR.red, LOG_COLOR.green, LOG_COLOR.blue,
                               LOG_ALPHA, local.font_desc, "left");
        if (!log_sprites[i])
            log_sprites[i] = Sprite();
        log_sprites[i].SetImage(local.img);
        log_sprites[i].SetPosition(local.x,
                                     local.panel_top + local.padding + i * local.line_h,
                                     10000);
        log_sprites[i].SetOpacity(1);
    }

    for (i = log_count; i < MAX_LOG_LINES; i++) {
        if (log_sprites[i])
            log_sprites[i].SetOpacity(0);
    }
}

Plymouth.SetMessageFunction(message_callback);

# A refresh function is required so Plymouth keeps updating the display.
fun refresh_callback() {
}

Plymouth.SetRefreshFunction(refresh_callback);

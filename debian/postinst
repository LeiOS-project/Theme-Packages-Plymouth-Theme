#!/bin/sh
# postinst for leios.theme.plymouth-theme
# Sets LeiOS as the default Plymouth theme and rebuilds the initramfs.

set -e

THEME="leios"
DEFAULTS="/usr/share/plymouth/plymouthd.defaults"
STATE_DIR="/var/lib/leios.theme.plymouth-theme"
PREVIOUS_THEME_FILE="${STATE_DIR}/previous-theme"

save_previous_theme() {
    if [ ! -f "${PREVIOUS_THEME_FILE}" ]; then
        mkdir -p "${STATE_DIR}"
        CURRENT=$(sed -n 's/^[[:space:]]*Theme=\(.*\)/\1/p' "${DEFAULTS}" | head -1)
        echo "${CURRENT:-ceratopsian}" > "${PREVIOUS_THEME_FILE}"
    fi
}

set_default_theme() {
    if [ -f "${DEFAULTS}" ]; then
        save_previous_theme
        sed -i 's/^[[:space:]]*Theme=.*/Theme='"${THEME}"'/' "${DEFAULTS}"
    else
        echo "WARNING: ${DEFAULTS} not found, cannot set default Plymouth theme" >&2
    fi
}

rebuild_initramfs() {
    if [ -x /usr/sbin/update-initramfs ]; then
        update-initramfs -u || true
    else
        echo "WARNING: update-initramfs not found; please rebuild the initramfs manually" >&2
    fi
}

case "$1" in
    configure|triggered)
        set_default_theme
        rebuild_initramfs
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0

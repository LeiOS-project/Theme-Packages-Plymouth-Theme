#!/bin/sh
# postrm for leios.theme.plymouth-theme
# Puts Debian's plymouthd.defaults back once this package's copy is gone. The
# initramfs is rebuilt through the update-initramfs trigger (debian/triggers).

set -e

DEFAULTS="/usr/share/plymouth/plymouthd.defaults"

remove_diversion() {
    dpkg-divert --package leios.theme.plymouth-theme --remove --rename --quiet \
        --divert "${DEFAULTS}.distrib" "${DEFAULTS}"
}

case "$1" in
    remove|abort-install|disappear)
        remove_diversion
    ;;

    abort-upgrade)
        # The version being upgraded from did not divert the file.
        if dpkg --compare-versions "$2" lt 1.1.0~; then
            remove_diversion
        fi
    ;;

    purge|upgrade|failed-upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0

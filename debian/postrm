#!/bin/sh
# postrm for leios.theme.plymouth-theme
# Restores the previous Plymouth default theme and rebuilds the initramfs.

set -e

THEME="leios"
DEFAULTS="/usr/share/plymouth/plymouthd.defaults"
STATE_DIR="/var/lib/leios.theme.plymouth-theme"
PREVIOUS_THEME_FILE="${STATE_DIR}/previous-theme"

restore_previous_theme() {
    if [ -f "${DEFAULTS}" ] && [ -f "${PREVIOUS_THEME_FILE}" ]; then
        PREVIOUS=$(cat "${PREVIOUS_THEME_FILE}")
        sed -i 's/^[[:space:]]*Theme=.*/Theme='"${PREVIOUS}"'/' "${DEFAULTS}"
    fi
    rm -f "${PREVIOUS_THEME_FILE}"
    rmdir "${STATE_DIR}" 2>/dev/null || true
}

rebuild_initramfs() {
    if [ -x /usr/sbin/update-initramfs ]; then
        update-initramfs -u || true
    fi
}

case "$1" in
    remove|purge|disappear)
        restore_previous_theme
        rebuild_initramfs
    ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#

exit 0
